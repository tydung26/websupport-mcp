# Websupport API credentials — https://admin.websupport.sk (Security → API keys)
# The API key is the public identifier; the secret is the HMAC-SHA1 signing key.
WEBSUPPORT_API_KEY=
WEBSUPPORT_API_SECRET=

# Market selection. Defaults to https://rest.websupport.sk when unset.
# Live hosts: rest.websupport.sk | rest.websupport.cz | rest.websupport.hu | rest.websupport.se
# WEBSUPPORT_API_BASE_URL=https://rest.websupport.sk

# Response language. One of: en_us | sk | cs_cz | hu. Defaults to en_us.
# WEBSUPPORT_ACCEPT_LANGUAGE=en_us

# Risk-tier opt-ins. Both default to off; each is independent.
# Tiers gate tool REGISTRATION, so an unset opt-in hides the tools entirely.
# WEBSUPPORT_ALLOW_WRITE=1
# WEBSUPPORT_ALLOW_DESTRUCTIVE=1
